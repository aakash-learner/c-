#include <stdbool.h>

bool predictTheWinner(int* nums, int numsSize) {
    if (numsSize % 2 == 0) {
        return true;
    }
    int dp[20];
    for (int i = 0; i < numsSize; i++) {
        dp[i] = nums[i];
    }
    for (int length = 2; length <= numsSize; length++) {
        for (int i = 0; i <= numsSize - length; i++) {
            int j = i + length - 1;
            int pickLeft = nums[i] - dp[i + 1];
            int pickRight = nums[j] - dp[i];
            dp[i] = (pickLeft > pickRight) ? pickLeft : pickRight;
        }
    }
    return dp[0] >= 0;
}
