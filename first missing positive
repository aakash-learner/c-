int firstMissingPositive(int* nums, int numsSize) {
    // Phase 1: Cyclic sort to place each number x at index x - 1
    for (int i = 0; i < numsSize; i++) {
        // Keep swapping if the current number is in the valid range [1, numsSize]
        // and it is not already at its correct target index (nums[i] - 1)
        while (nums[i] > 0 && nums[i] <= numsSize && nums[nums[i] - 1] != nums[i]) {
            // Swap nums[i] with the element at its target position
            int targetIdx = nums[i] - 1;
            int temp = nums[i];
            nums[i] = nums[targetIdx];
            nums[targetIdx] = temp;
        }
    }

    // Phase 2: Find the first index where the identity does not match
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] != i + 1) {
            return i + 1;
        }
    }

    // If all positions 1 to n are filled correctly, the missing number is n + 1
    return numsSize + 1;
}
